# Neon Postgres (use the *pooled* connection string from Neon → Connect)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login sessions — any long random string (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Neon Object Storage (Neon → Connect → Storage → Parameters only)
# Note: don't use the AWS_* names on Vercel — Vercel reserves them for its own runtime.
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-9.eu-central-1.aws.neon.tech
NEON_STORAGE_ACCESS_KEY_ID=nak_live_...
NEON_STORAGE_SECRET_ACCESS_KEY=nsk_live_...
NEON_STORAGE_REGION=eu-central-1
STORAGE_BUCKET=bokra
